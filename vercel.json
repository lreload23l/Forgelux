{
  "functions": {
    "api/chat.js": {
      "memory": 128,
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "forgelux.co.uk"
        }
      ],
      "destination": "https://www.forgelux.co.uk/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/login.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/dashboard.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
